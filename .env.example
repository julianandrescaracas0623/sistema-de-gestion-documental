# =============================================================================
# REQUERIDAS — la app no arranca sin estas (se validan al boot: src/shared/lib/env.ts)
# =============================================================================

# Supabase — https://supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL pública de la app. En local http://localhost:3000; en producción tu dominio
# real (https://...). Se usa para los enlaces de los correos de recuperación —
# si apunta a localhost, los correos de producción no funcionan.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# REQUERIDAS para migraciones y features de administración
# =============================================================================

# Connection string de Supabase > Project Settings > Database > Session mode (URI).
# Necesaria para: pnpm db:*, scripts/*.mjs y pnpm db:setup.
DATABASE_URL=postgresql://postgres.your-project-id:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Service role — Project Settings > API. NUNCA en el cliente ni con prefijo NEXT_PUBLIC_.
# Necesaria para: alta de usuarios (/admin/users) y saludo personalizado en el
# correo de recuperación. Sin ella la app arranca, pero esas acciones fallan con
# un mensaje claro.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# OPCIONALES
# =============================================================================

# Tamaño máximo por archivo subido, en MB (por defecto 25).
DOCUMENT_UPLOAD_MAX_MB=25

# Secreto para el endpoint de purga por retención (POST /api/documents/purge).
# Llámalo desde un cron con: Authorization: Bearer <CRON_SECRET>.
# Sin esta variable el endpoint responde 501.
CRON_SECRET=

# Poner a 1 para saltar la validación de env (solo lint/typecheck en CI sin secretos).
# SKIP_ENV_VALIDATION=1
